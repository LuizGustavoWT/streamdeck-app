{
  "name": "streamdeck-app",
  "version": "1.0.0",
  "private": true,
  "description": "React Native app + OpenDeck plugin for Stream Deck mobile control",
  "workspaces": [
    "shared",
    "plugin/com.streamdeckapp.mobile.sdPlugin",
    "mobile"
  ],
  "scripts": {
    "mobile:start": "cd mobile && NODE_OPTIONS='--no-experimental-strip-types' npx expo start",
    "mobile:android": "cd mobile && NODE_OPTIONS='--no-experimental-strip-types' npx expo start --android",
    "plugin:dev": "cd plugin/com.streamdeckapp.mobile.sdPlugin && NODE_OPTIONS='--no-experimental-strip-types' tsx src/index.ts",
    "plugin:build": "cd plugin/com.streamdeckapp.mobile.sdPlugin && npm run build",
    "lint": "cd mobile && npx eslint ."
  }
}
